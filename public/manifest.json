{
  "manifest_version": 3,
  "name": "Jira Worklog Logger",
  "version": "1.0.0",
  "description": "Parse and log your work entries to Jira with ease",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://*.jira.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
